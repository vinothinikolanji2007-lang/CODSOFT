list1=[]

while True:
	print("***MENU***")
	print("1.create task")
	print("2.update task")
	print("3.track task")

	choice=int(input("Enter your choice: "))

	if choice==1:
		new_task=input("enter you task: ")
		list1.append(new_task)
		print("task created")

	elif choice==2:
		print("__Task__")
		for i in list1:
			print(i,"->pending")
		n=int(input("enter num task toupdate:"))
		task1=input("Enter your task: ")
		list1[n-1]=task1
		print("task updated succesfully!")
		print(list1)

	elif choice==3:
		for i in range(len(list1)):
			print(list1[i],"---> completed")

	else:
		print("Invalid choice!!")